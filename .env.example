# Copy this file to ".env" and fill in your key.  ( cp .env.example .env )

# ── REQUIRED ──────────────────────────────────────────────────────────────
# Your Anthropic API key. Get one at https://console.anthropic.com/
# This is the ONLY thing required to run. You pay for your own usage; every
# run shows an estimate first and enforces a hard budget cap.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── OPTIONAL: real-world grounding sources ────────────────────────────────
# Only needed if you turn a grounding source ON in the setup wizard. The tool
# runs fine with NO grounding (or with a quotes file you provide yourself).
# You bring your own credentials and accept each provider's Terms of Service.

# Reddit  (https://www.reddit.com/prefs/apps  ->  create a "script" app)
# REDDIT_CLIENT_ID=
# REDDIT_CLIENT_SECRET=
# REDDIT_USER_AGENT=synthetic-society/1.0 by u/yourusername

# YouTube Data API (https://console.cloud.google.com/ -> enable YouTube Data API v3)
# Only the "YouTube comments" source needs this key.
# YOUTUBE_API_KEY=

# "Web articles" and "YouTube transcripts" grounding need NO key — just install the
# optional package:   pip install trafilatura   /   pip install yt-dlp

# Apify (https://console.apify.com/account/integrations) — heavy web / Reddit / X
# scraping via your own token. Runs Apify's "RAG Web Browser" actor by default;
# override APIFY_ACTOR to point at any scraper, and APIFY_INPUT_KEY to match that
# actor's search field. Called over the REST API (no SDK, no MCP).
# APIFY_TOKEN=
# APIFY_ACTOR=apify/rag-web-browser
# APIFY_INPUT_KEY=query
